# Copy to .env and adjust. Never commit .env; on the server: chmod 600 .env.
# Production values: docs/INSTALL.md §5. Docker Compose reads this file too (ports, log dir).

# development | production. development only on this machine: the application refuses to
# start in development when AGAURA_BASE_URL or AGAURA_DOMAIN is a public address, and the
# Docker image runs in production when this line is missing.
AGAURA_ENVIRONMENT=development

# Master secret (at least 32 characters), required in production. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Changing it makes stored session passwords and printed codes unusable, and the audit log
# (hash-chained with a key derived from it) fails "agaura audit verify": keep a copy outside
# the server.
AGAURA_SECRET_KEY=

# Email: console (development, nothing sent) or smtp (Infomaniak).
AGAURA_EMAIL_BACKEND=console
# AGAURA_SMTP_HOST=mail.infomaniak.com
# AGAURA_SMTP_PORT=465
# AGAURA_SMTP_USERNAME=no-reply@agaura.org
# AGAURA_SMTP_PASSWORD=
# AGAURA_EMAIL_FROM="AGaura <no-reply@agaura.org>"

# Public signup: closed (default: accounts are created by invitation from the super-admin
# page /superadmin) or open (anyone can sign up, with the anti-bot check). Create the
# super-admin on the server: docker compose exec app agaura user create EMAIL --superadmin
AGAURA_SIGNUP=closed

# Address shown on the home, login and signup pages to ask for an account while signup is closed.
AGAURA_CONTACT_EMAIL=contact@agaura.org

# Demo (FR-09a), on by default: "Essayer la démo" on the home and login pages opens an account
# of one's own with example sessions, deleted after 2 h without activity and at most 24 h. At
# most AGAURA_DEMO_MAX demo accounts at once. false turns it off.
AGAURA_DEMO=true
AGAURA_DEMO_MAX=50

# Public repository of the running code, linked from every page (AGPL license, section 13:
# users of a modified version must be offered its source). Empty: no link.
AGAURA_SOURCE_URL=

# Public address of the application, used in emails (https://agaura.org in production).
AGAURA_BASE_URL=https://localhost

# Domain served by Caddy: localhost locally, agaura.org in production.
AGAURA_DOMAIN=localhost

# Host ports published by Caddy (change if 80/443 are already taken locally).
HTTP_PORT=80
HTTPS_PORT=443

# Host directory of Caddy's access log, read by fail2ban on the server
# (/srv/agaura/logs/caddy in production, deploy/README.md).
CADDY_LOG_DIR=./logs/caddy

# Host directory of the automatic backups (a copy of the database once a day and after each
# poll closing), outside the Docker volumes. It must exist and belong to uid 1000, the
# application's user in the container; the application does not start without it:
#   mkdir -p -m 700 backups/auto   (docs/INSTALL.md §4)
BACKUP_DIR=./backups/auto
# Days an automatic backup is kept (the latest one always is).
AGAURA_BACKUP_KEEP_DAYS=30
