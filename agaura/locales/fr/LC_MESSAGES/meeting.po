#: web/manage/meeting.py:60
msgid "Item under discussion changed"
msgstr "Point en cours de l'ordre du jour changé"

#: web/manage/meeting.py:63
msgid "Item %(number)s is longer than 200 characters: shorten it."
msgstr "Le point %(number)s dépasse 200 caractères : raccourcissez-le."

#: templates/manage/_tribune.html:51
msgid "One row per person, in the order of the minutes; the function is optional. Empty a row to remove that person."
msgstr "Une ligne par personne, dans l'ordre du procès-verbal ; la fonction est facultative. Pour retirer une personne, videz sa ligne."

#: templates/manage/_tribune.html:61
msgid "Add a person"
msgstr "Ajouter une personne"

#: templates/manage/_attendance.html:5
msgid "%(num)s reading"
msgid_plural "%(num)s readings"
msgstr[0] "%(num)s relevé"
msgstr[1] "%(num)s relevés"

#: templates/manage/_attendance.html:18
msgid "No reading yet."
msgstr "Aucun relevé pour l'instant."

#: templates/manage/_attendance.html:20
msgid "A reading is taken when the session opens and closes, each time the headcount is saved and when a poll is pushed or closed; never when someone joins or votes. Connections: accesses in use at that moment, as Attendees."
msgstr "Un relevé est pris à l'ouverture et à la clôture de la session, à chaque effectif enregistré et à chaque vote lancé ou clos ; jamais à l'arrivée ni au vote d'une personne. Connexions : accès en cours à ce moment, comme « Présents »."

