#: templates/manage/_links.html:7
msgid "Projection screen"
msgstr "Écran de projection"

#: templates/manage/_links.html:10
msgid "Projection screen link"
msgstr "Lien de l'écran de projection"

#: templates/manage/_links.html:11 templates/manage/_links.html:26
msgid "Copied"
msgstr "Copié"

#: templates/manage/_links.html:11 templates/manage/_links.html:26
msgid "Copy"
msgstr "Copier"

#: templates/manage/_links.html:12
msgid "Open the screen"
msgstr "Ouvrir l'écran"

#: templates/manage/_links.html:14
msgid "Create a new screen link? The current link stops working, including on a screen already open."
msgstr "Créer un nouveau lien d'écran ? Le lien actuel ne fonctionnera plus, y compris sur un écran déjà ouvert."

#: templates/manage/_links.html:16
msgid "New screen link"
msgstr "Nouveau lien d'écran"

#: templates/manage/_links.html:21 templates/manage/_links.html:25
msgid "Public results link"
msgstr "Lien public des résultats"

#: templates/manage/_links.html:23
msgid "Anyone with this secret link can see the results of the session. Share it with the members."
msgstr "Toute personne disposant de ce lien secret peut voir les résultats de la session. Partagez-le avec les membres."

#: templates/manage/_links.html:27
msgid "Open the page"
msgstr "Ouvrir la page"

#: templates/manage/_links.html:29
msgid "Disable the public results link? It stops working for everyone who has it."
msgstr "Désactiver le lien public des résultats ? Il ne fonctionnera plus pour personne."

#: templates/manage/_links.html:32
msgid "Disable the link"
msgstr "Désactiver le lien"

#: templates/manage/_links.html:35
msgid "Disabled. Once enabled, a secret link shows the results of the session to anyone who has it, for example the members who could not attend."
msgstr "Désactivé. Une fois activé, un lien secret montre les résultats de la session à toute personne qui le possède, par exemple les membres absents."

#: templates/manage/_links.html:39
msgid "Enable the public link"
msgstr "Activer le lien public"

#: templates/screen/_state.html:38 templates/screen/macros.html:22
msgid "The session will start shortly."
msgstr "La session va bientôt commencer."

#: templates/screen/macros.html:51
msgid "To vote"
msgstr "Pour voter"

#: templates/screen/macros.html:28
msgid "Or scan the QR code: it joins directly."
msgstr "Ou scannez le QR code : il vous connecte directement."

#: templates/screen/macros.html:30
msgid "Then enter the code printed on your card, or scan the QR code of your card."
msgstr "Puis saisissez le code imprimé sur votre carte, ou scannez le QR code de la carte."

#: templates/screen/macros.html:32
msgid "You can already scan: your phone will join as soon as the session opens."
msgstr "Vous pouvez déjà scanner : votre téléphone rejoindra la session dès son ouverture."

#: templates/screen/macros.html:41
msgid "Closes in"
msgstr "Clôture dans"

#: templates/screen/macros.html:51
msgid "Vote in progress"
msgstr "Vote en cours"

#: templates/screen/macros.html:60
msgid "Grade each option."
msgstr "Évaluez chaque option."

#: templates/screen/page.html:13
msgid "Full screen"
msgstr "Plein écran"

#: web/manage/links.py:26
msgid "New screen link created: the previous one no longer works."
msgstr "Nouveau lien d'écran créé : l'ancien ne fonctionne plus."

#: web/manage/links.py:27
msgid "Public results link enabled."
msgstr "Lien public des résultats activé."

#: web/manage/links.py:28
msgid "Public results link disabled: it no longer works."
msgstr "Lien public des résultats désactivé : il ne fonctionne plus."

#: templates/manage/_finished.html:16
msgid "Two separate actions: publish, on the voters' phones; show on the screen, in the room, the verdict and, from %(num)s ballots, the count of each option. A cancelled poll is never shown."
msgstr "Deux gestes indépendants : publier, sur les téléphones des votants ; afficher sur l'écran, dans la salle, le verdict et, à partir de %(num)s bulletins, le détail des voix. Un vote annulé ne s'affiche jamais."

#: templates/manage/_finished.html:45
msgid "Publish the result to voters"
msgstr "Publier le résultat aux votants"

