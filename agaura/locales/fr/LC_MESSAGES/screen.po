# Results on the projection screen (FR-75): console of the finished polls.

#: templates/manage/_finished.html:28
msgid "On the screen"
msgstr "À l'écran"

#: templates/manage/_finished.html:64
msgid "Display on the screen"
msgstr "Afficher sur l'écran"

#: templates/manage/_finished.html:62
msgid "Take off the screen"
msgstr "Retirer de l'écran"

#: templates/manage/_finished.html:68
msgid "Fewer than %(num)s ballots: the screen shows the verdict only."
msgstr "Moins de %(num)s bulletins : l'écran n'affiche que le verdict."

#: templates/manage/_links.html:5
msgid "Open this secret link on the computer connected to the projector: it updates by itself and shows a result only when the tribune chooses to, poll by poll."
msgstr "Ouvrez ce lien secret sur l'ordinateur relié au vidéoprojecteur : il se met à jour tout seul et n'affiche un résultat que si la tribune le choisit, vote par vote."

#: web/manage/polls.py:36
msgid "Result shown on the screen."
msgstr "Résultat affiché à l'écran."

#: web/manage/polls.py:37
msgid "Result taken off the screen."
msgstr "Résultat retiré de l'écran."

#: web/manage/polls.py:42
