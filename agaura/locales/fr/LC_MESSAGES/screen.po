msgstr "Classement par mention majoritaire ; une option sans mention compte « %(grade)s »."

#: templates/screen/macros.html:234
msgid "Count of votes not shown: fewer than %(num)s ballots"
msgstr "Détail des voix non affiché : moins de %(num)s bulletins"

