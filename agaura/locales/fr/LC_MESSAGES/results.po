msgstr[1] "%(num)s sièges à pourvoir."

#: templates/macros/results.html:83
msgid "Elected candidates need more than %(share)s of valid votes."
msgstr "Pour être élu·e, il faut plus de %(share)s des suffrages exprimés."

#: templates/macros/results.html:84
